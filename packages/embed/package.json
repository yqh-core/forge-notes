{
  "name": "@forge-notes/embed",
  "version": "1.0.0",
  "type": "module",
  "description": "Forge Notes 嵌入式组件包：把博客作为子功能挂到任意站点（Vue 组件 / Web Component 双形态）",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "main": "./dist/forge-notes.js",
  "module": "./dist/forge-notes.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./dist/forge-notes.js",
    "./style.css": "./dist/forge-notes.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-embed-content.mjs && vite build"
  },
  "keywords": [
    "blog",
    "embeddable",
    "web-component",
    "vue3"
  ],
  "author": "yqh",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "markdown-it": "^14.1.0",
    "vite": "^7.0.0",
    "vue": "^3.5.25"
  }
}
